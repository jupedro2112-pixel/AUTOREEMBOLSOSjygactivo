+    } else if (tab === 'today' || tab === 'day') {
+      const dayKey = tab === 'day' && /^\d{4}-\d{2}-\d{2}$/.test(String(req.query.day || '')) ? String(req.query.day) : _artDateKey();
+      const r = _artDayRange(dayKey);
